# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, add the same variables in Project → Settings → Environment Variables.

# Resend API key (https://resend.com/api-keys). Server-only: do NOT prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Sender address on a domain verified in Resend, e.g. "MobAppCreator Website <website@mobappcreator.com>"
CONTACT_FROM_EMAIL=

# Where messages are delivered (comma-separated for several). Defaults to info@mobappcreator.com.
CONTACT_TO_EMAIL=info@mobappcreator.com
